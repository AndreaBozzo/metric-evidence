/// Product categories plus an explicit Unknown row for orders whose label is missing.
table Category

	column category_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: category_key

	column category_name
		dataType: string
		summarizeBy: none
		sourceColumn: category_name
		sortByColumn: sort_order

	column sort_order
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sort_order

	/// True for the Unknown (label missing) row.
	column is_unknown
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_unknown

	partition Category = m
		mode: import
		source =
				let
					Source = fnReadCsv("dim_category.csv", {{"category_key", type text}, {"category_name", type text}, {"sort_order", Int64.Type}, {"is_unknown", type logical}})
				in
					Source

