/// Absolute path of this clone's data folder (orders, dimensions, evidence). Ships as a placeholder; set it with `uv run python prep/configure_report.py`, or in Transform data > Edit parameters.
expression DataFolder = "<not set: run prep/configure_report.py>" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: a3523784-ace8-4c7e-a8b2-d2645d1ecfea
	queryGroup: Parameters

	annotation PBI_ResultType = Text

/// Reads one prepared CSV from DataFolder: UTF-8, header row, empty cells become null, types applied with the en-US culture so "123.45" parses the same on any machine locale.
expression fnReadCsv =
		(fileName as text, columnTypes as list) as table =>
		let
		    Folder =
		        if Text.StartsWith(DataFolder, "<") then
		            error Error.Record("DataFolder is not set", "Run: uv run python prep/configure_report.py (from the repository root), or set Transform data > Edit parameters > DataFolder to the repository's data folder.")
		        else if Text.EndsWith(DataFolder, "\") then DataFolder else DataFolder & "\",
		    Raw = Csv.Document(File.Contents(Folder & fileName), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
		    EmptyAsNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
		    Typed = Table.TransformColumnTypes(EmptyAsNull, columnTypes, "en-US")
		in
		    Typed
	lineageTag: 32cfc307-a782-457b-85e6-f822a51bc7ea
	queryGroup: Helpers

	annotation PBI_ResultType = Function

